    "exifreader": "^4.54.0",
    "fast-xml-parser": "^5.12.1",
    "fflate": "^0.8.3",
    "lucide-react": "^1.72.0",
    "marked": "^18.2.0",
    "next": "16.4.6",
    "next-themes": "^0.4.6",
    "papaparse": "^5.7.1",
    "pica": "^10.0.3",
